// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.terrainstudio.app",
  "asar": true,
  "productName": "Terrain Studio",
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist",
    "dist-electron"
  ],
  // The MCreator plugin rides along as a resource so the app can install it into MCreator on launch.
  // Rebuild it with `npm run plugin:bundle`; the copy is committed because packaging runs without MCreator.
  "extraResources": [
    {
      "from": "build/mcreator-plugin/terrain-studio.zip",
      "to": "terrain-studio-plugin.zip"
    }
  ],
  "mac": {
    "target": [
      "dmg"
    ],
    "category": "public.app-category.developer-tools",
    "artifactName": "${productName}-Mac-${version}-Installer.${ext}"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      },
      {
        // A Windows Installer package for people who deploy with group policy or Intune.
        "target": "msi",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}-Windows-${version}-Setup.${ext}"
  },
  "msi": {
    "artifactName": "${productName}-Windows-${version}.${ext}"
  },
  "portable": {
    "artifactName": "${productName}-Windows-${version}-Portable.${ext}"
  },
  "nsis": {
    "artifactName": "${productName}-Windows-${version}-Setup.${ext}",
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "linux": {
    "target": [
      "AppImage"
    ],
    "category": "Development",
    "artifactName": "${productName}-Linux-${version}.${ext}"
  }
}
